{
  "name": "ally-companion",
  "version": "0.5.4",
  "description": "Decky plugin: speaker DSP, hardware fixes, lighting and update news for the ROG Xbox Ally X and ROG Ally X on SteamOS",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "node scripts/gen-version.mjs && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassobr/Decky-Ally-Companion.git"
  },
  "keywords": ["decky", "plugin", "rog-ally-x", "xbox-ally-x", "steamos", "inputplumber"],
  "author": "bassobr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bassobr/Decky-Ally-Companion/issues"
  },
  "homepage": "https://github.com/bassobr/Decky-Ally-Companion#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.63.6",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
